# Copy this file to .env and fill in your own values. Never commit .env.

PORT=3000

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WEBHOOK_VERIFY_TOKEN=
# App secret from the Meta developer dashboard. When set, every webhook
# request must carry a valid X-Hub-Signature-256 header.
META_APP_SECRET=

# Google Sheets (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# Set to true to log full webhook payloads (contains personal data, local debugging only)
DEBUG_WEBHOOK=false
